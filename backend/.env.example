DATABASE_URL=postgresql+psycopg://code_garden:replace-with-local-password@127.0.0.1:5432/code_garden
POSTGRES_USER=code_garden
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=code_garden
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=30
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Host backend; inside Docker use http://server:2358 on the Judge0 network.
JUDGE0_URL=http://localhost:2358
# Fill IDs ONLY after checking GET /languages. null = unavailable/unconfigured.
JUDGE0_PYTHON_LANGUAGES={"3.11":null,"3.12":null,"3.13":null,"3.14":null}
JUDGE0_POLL_INTERVAL_MS=250
# Total-wait baseline; effective deadline = max(this value, task wall time + 5s).
# Also used as the per-request HTTP timeout.
JUDGE0_MAX_WAIT_SECONDS=5
